MONGO_URI=mongodb+srv://your_user:your_password@cluster.mongodb.net/taskflow?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_key_change_this_32chars
PORT=5000
CLIENT_URL=http://localhost:5173

# Optional AI Features Key (Google Gemini API)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional OAuth 2.0 Credentials (GitHub & LinkedIn)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback

LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_CALLBACK_URL=http://localhost:5000/api/auth/linkedin/callback
